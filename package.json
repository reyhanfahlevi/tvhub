{
  "name": "tvhub",
  "version": "1.0.0",
  "type": "module",
  "description": "Central management hub and dashboard for tvhome Android TVs",
  "main": "dist/server/index.js",
  "bin": {
    "tvhub": "./bin/tvhub.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "prepublishOnly": "npm run build",
    "design:lint": "npx @google/design.md lint DESIGN.md",
    "design:export": "npx @google/design.md export --format tailwind DESIGN.md",
    "start": "node dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reyhanfahlevi/tvhub.git"
  },
  "keywords": [
    "android-tv",
    "tvhub",
    "cleanyourtv",
    "dashboard",
    "remote-control",
    "mdns"
  ],
  "author": "Reyhan Fahlevi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reyhanfahlevi/tvhub/issues"
  },
  "homepage": "https://github.com/reyhanfahlevi/tvhub#readme",
  "dependencies": {
    "adhan": "^4.4.6",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
